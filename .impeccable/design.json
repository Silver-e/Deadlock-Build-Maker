  "components": [
    {
      "name": "Olive button",
      "kind": "button",
      "refersTo": "button",
      "description": "Compact ordinary action, as used for Add category.",
      "html": "<button class=\"ds-button\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg>Add category</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:8px 12px;border:1px solid #525646;border-radius:4px;background:#373c30;color:var(--cream,#eee5d2);font:700 14px Retail,sans-serif;cursor:pointer;transition:background-color .2s cubic-bezier(.22,1,.36,1),opacity .2s cubic-bezier(.22,1,.36,1)}.ds-button:hover{background:#4b5140}.ds-button:active{transform:translateY(1px)}.ds-button:focus-visible{outline:2px solid #f0dfb5;outline-offset:3px}.ds-button:disabled{opacity:.35;cursor:default;transform:none}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}"
    },
    {
      "name": "Cream button",
      "kind": "button",
      "refersTo": "button-cream",
      "description": "Prominent New build and Equip item action.",
      "html": "<button class=\"ds-button ds-cream\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg>New build</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:8px 12px;border:1px solid #525646;border-radius:4px;background:#373c30;color:var(--cream,#eee5d2);font:700 14px Retail,sans-serif;cursor:pointer;transition:background-color .2s cubic-bezier(.22,1,.36,1),opacity .2s cubic-bezier(.22,1,.36,1)}.ds-button:hover{background:#4b5140}.ds-button:active{transform:translateY(1px)}.ds-button:focus-visible{outline:2px solid #f0dfb5;outline-offset:3px}.ds-button:disabled{opacity:.35;cursor:default;transform:none}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}.ds-cream{background:#e4dac1;color:#2a2e24;border-color:#e4dac1}.ds-cream:hover{background:#fff0cf}"
    },
    {
      "name": "Item search",
      "kind": "input",
      "refersTo": "field",
      "description": "Inset icon field used in the shop filter row.",
      "html": "<label class=\"ds-search\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><path d=\"M21 21l-5-5M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0\"/></svg><input aria-label=\"Search items or stats\" placeholder=\"Search items or stats?\"/></label>",
      "css": ".ds-search{display:flex;align-items:center;gap:8px;background:#252b20;border:1px solid #555e48;border-radius:3px;padding:0 8px;color:#a7b09a;max-width:420px}.ds-search input{width:100%;min-width:0;border:0;background:transparent;color:var(--cream,#eee5d2);font:12px Retail,sans-serif;padding:8px 0;outline-offset:0}.ds-search input::placeholder{color:#a4a893}.ds-search input:focus-visible,.ds-tab:focus-visible,.ds-empty:focus-visible,.ds-investment summary:focus-visible{outline:2px solid #f0dfb5;outline-offset:3px}"
    },
    {
      "name": "Item type navigation",
      "kind": "nav",
      "description": "Equal-width tabs retain their category identity; Weapon is selected in this preview.",
      "html": "<nav class=\"ds-tabs\" aria-label=\"Item type\"><button class=\"ds-tab ds-weapon ds-chosen\" aria-pressed=\"true\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><path d=\"M5 15 15 5l4 4L9 19H5v-4ZM13 7l4 4M4 21h6\"/></svg>Weapon</button><button class=\"ds-tab ds-vitality\" aria-pressed=\"false\">Vitality</button><button class=\"ds-tab ds-spirit\" aria-pressed=\"false\">Spirit</button></nav>",
      "css": ".ds-tabs{display:flex;gap:4px;background:#20231d;padding-bottom:4px}.ds-tab{display:inline-flex;align-items:center;justify-content:center;gap:8px;flex:1;border:0;border-top:4px solid var(--ds-type);border-radius:3px 3px 0 0;background:#32372b;color:#cfcbc1;opacity:.7;padding:16px 12px;font:600 20px Occult,serif;cursor:pointer}.ds-weapon{--ds-type:var(--weapon,#d9a14c)}.ds-vitality{--ds-type:var(--vitality,#8caf56)}.ds-spirit{--ds-type:var(--spirit,#b49bcc)}.ds-tab.ds-chosen{background:var(--ds-type);color:#29291e;opacity:1}.ds-tab:hover{opacity:1}.ds-tab:active{transform:translateY(1px)}.ds-search input:focus-visible,.ds-tab:focus-visible,.ds-empty:focus-visible,.ds-investment summary:focus-visible{outline:2px solid #f0dfb5;outline-offset:3px}"
    },
    {
      "name": "Selected category",
      "kind": "card",
      "refersTo": "category-selected",
      "description": "Selected editable category with its empty shop target; all controls use the existing category geometry.",
      "html": "<section class=\"ds-category\"><input class=\"ds-category-name\" aria-label=\"Category name\" value=\"Early game\"/><input class=\"ds-category-note\" aria-label=\"Category note\" placeholder=\"Add a category note?\"/><button class=\"ds-empty\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg><span>Select items from the shop<br/><small>or drag them here</small></span></button><span class=\"ds-selected-label\">Adding items here</span></section>",
      "css": ".ds-category{padding:8px;max-width:420px;min-width:0;border:1px solid #c8c8a8;border-radius:3px;background:#343e2b;box-shadow:inset 0 0 0 1px #aeb394;color:var(--cream,#eee5d2);font-family:Retail,sans-serif}.ds-category-name,.ds-category-note{display:block;width:100%;box-sizing:border-box;padding:4px;border:1px solid transparent;background:transparent;color:inherit;font:700 14px Retail,sans-serif}.ds-category-note{font-size:12px;font-weight:400;margin-bottom:8px}.ds-category-note::placeholder{color:#a4a893}.ds-category-name:focus,.ds-category-note:focus{background:#252c20;border-color:#747f61;outline:2px solid #f0dfb5;outline-offset:3px}.ds-empty{display:flex;align-items:center;justify-content:center;gap:12px;width:100%;min-height:76px;padding:12px;border:1px dashed #6a7559;border-radius:4px;background:transparent;color:#c2cbb5;font:400 12px Retail,sans-serif;cursor:pointer}.ds-empty:hover{background:#4b5140}.ds-empty:active{transform:translateY(1px)}.ds-empty small{font-size:12px;color:#b0bba1}.ds-selected-label{display:block;margin-top:8px;color:#d6dfc8;font-size:10px;letter-spacing:.02em;text-align:right}.ds-search input:focus-visible,.ds-tab:focus-visible,.ds-empty:focus-visible,.ds-investment summary:focus-visible{outline:2px solid #f0dfb5;outline-offset:3px}"
    },
    {
      "name": "Active item ribbon",
      "kind": "chip",
      "refersTo": "active-tag",
      "description": "Static item-property ribbon; this is not a selectable chip.",
      "html": "<span class=\"ds-active\">ACTIVE</span>",
      "css": ".ds-active{display:block;width:82px;text-align:center;background:#424236;color:#e8dfca;font:700 8px/10px Retail,sans-serif;letter-spacing:.08em}"
    },
    {
      "name": "Investment threshold",
      "kind": "custom",
      "description": "Native expandable investment row with category color, threshold ticks, and aligned soul totals.",
      "html": "<details class=\"ds-investment\"><summary><span class=\"ds-investment-head\"><span><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><path d=\"M5 15 15 5l4 4L9 19H5v-4ZM13 7l4 4M4 21h6\"/></svg>Weapon</span><b>+0% <small>weapon damage</small></b><span>0 <small>souls</small></span></span><span class=\"ds-track\"><i style=\"left:11.11%\"></i><i style=\"left:26.39%\"></i><i style=\"left:50%\"></i></span><span class=\"ds-caption\">800 to next bonus<span>800 souls</span></span></summary><div class=\"ds-threshold\"><strong>Weapon investment bonuses</strong><p>Only equipped items count. Item stats are additional to these bonuses.</p></div></details>",
      "css": ".ds-investment{position:relative;padding:12px;background:#292f24;color:var(--cream,#eee5d2);font:12px Retail,sans-serif;max-width:620px}.ds-investment summary{list-style:none;cursor:pointer}.ds-investment summary::-webkit-details-marker{display:none}.ds-investment-head{display:flex;align-items:center;justify-content:space-between;gap:12px;line-height:16px;font-variant-numeric:tabular-nums}.ds-investment-head>span:first-child{display:flex;align-items:center;gap:8px;color:var(--weapon,#d9a14c)}.ds-investment-head b{flex:1;color:var(--weapon,#d9a14c)}.ds-investment-head svg{width:16px;height:16px}.ds-investment-head small{font-size:10px;font-weight:400;color:#bac0ae}.ds-track{display:block;height:7px;position:relative;background:#151b12;margin-top:4px;overflow:hidden;border-radius:1px}.ds-track i{position:absolute;top:0;bottom:0;width:1px;background:#30392b}.ds-caption{display:flex;justify-content:space-between;gap:12px;font-size:9px;color:#a2ad96;line-height:14px}.ds-threshold{background:#242c20;border:1px solid #6c785a;padding:16px;box-shadow:0 8px 32px #0008;border-radius:4px;margin-top:12px}.ds-threshold strong{color:var(--weapon,#d9a14c);font-size:16px}.ds-threshold p{font-size:12px;color:#bac3ad}.ds-search input:focus-visible,.ds-tab:focus-visible,.ds-empty:focus-visible,.ds-investment summary:focus-visible{outline:2px solid #f0dfb5;outline-offset:3px}"
    }
  ],
  "narrative": {
    "northStar": "The Deadlock Shop",
    "overview": "This system reproduces the user's established in-game visual reference: dark olive shop panels, warm ivory lettering, and orange Weapon, green Vitality, and lavender Spirit categories. It is a dense working catalog with editable build categories, rather than a new visual identity. Bundled Retail and Valve Occult fonts and original game artwork carry the visual authority.\n\nCompact controls, cream item labels, soul-tier separators, and restrained borders keep a large number of items readable at once. Category color carries through tabs, artwork grounds, details, and investment bars. The layout preserves the separate roles of draft organization and equipped inventory.",
    "keyCharacteristics": [
      "Dense olive surfaces with warm ivory text.",
      "Persistent Weapon, Vitality, and Spirit color identities.",
      "Occult headings paired with compact Retail interface text.",
      "Small corner radii, thin borders, and independently scrolling work areas.",
      "Game artwork with documented local provenance."
    ],
    "rules": [
      {
        "name": "The Category Identity Rule",
        "body": "Weapon stays orange, Vitality stays green, and Spirit stays lavender across every component that represents those item types.",
        "section": "colors"
      },
      {
        "name": "The Game Font Rule",
        "body": "Use Occult for the established game headings and Retail for the working interface; load the bundled files so the shop retains its typography offline.",
        "section": "typography"
      }
    ],
    "dos": [
      "**Do** preserve the Weapon, Vitality, and Spirit category identities across tabs, artwork, details, and investment.",
      "**Do** retain the bundled Retail and Occult fonts and documented game assets for offline rendering.",
      "**Do** keep category selection, draft membership, and equipped state visually distinct.",
      "**Do** preserve visible keyboard focus and the reduced-motion behavior.",
      "**Do** keep image provenance in ASSETS.md and per-item source and iconSource records in data/items.json."
    ],
    "donts": [
      "**Don't** replace the user-pinned game-shop world with a new marketing or product identity.",
      "**Don't** use the category accents interchangeably or treat every draft item as equipped.",
      "**Don't** remove item names, type labels, or check marks and rely on color alone.",
      "**Don't** promote compact footer and ribbon microcopy into the default size for new body content.\r"
    ]
  }
}
